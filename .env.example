# Supabase project URL and public anon/publishable key for the web app.
# Get these from Supabase Dashboard > Project Settings > API.
# Never place a service_role key or ESP32 device credentials in VITE_* variables.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY

# Device shown/controlled by default. App users must be assigned in device_members.
VITE_DEFAULT_DEVICE_ID=swc-device-001